# Copy this file to .env and fill in real values:
#   cp env.example .env

# Which LLM answers questions once relevant chunks are retrieved.
# Options: none | anthropic | gemini
LLM_PROVIDER=none

# API key matching whichever provider you picked above.
#   anthropic -> get one at https://console.anthropic.com
#   gemini    -> get one at https://aistudio.google.com/apikey
LLM_KEY=your-key-here

# Optional: override the default model for your chosen provider.
# Defaults: anthropic -> claude-sonnet-4-6, gemini -> gemini-3.1-flash-lite
# LLM_MODEL=gemini-3.1-flash-lite

# Optional but recommended: protects /upload, /index, and /ask from anyone
# who can reach port 8000. Pick any string. If left blank, no auth is required.
API_KEY=

# Retrieval tuning -- both have safe defaults if left unset, and can still be
# overridden per-request in /ask ({"top_k": 10, "max_distance": 0.3}).
# See eval_threshold.py for how to find good values empirically for your data.
TOP_K=5
MAX_DISTANCE=0.25
