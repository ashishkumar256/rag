# Copy this file to .env and fill in real values:
#   cp env.example .env

# Which LLM answers questions once relevant chunks are retrieved.
# Options: anthropic | gemini
LLM_PROVIDER=anthropic

# API key matching whichever provider you picked above.
#   anthropic -> get one at https://console.anthropic.com
#   gemini    -> get one at https://aistudio.google.com/apikey
LLM_KEY=your-key-here

# Optional: override the default model for your chosen provider.
# Defaults: anthropic -> claude-sonnet-4-6, gemini -> gemini-2.0-flash
# LLM_MODEL=gemini-1.5-pro

# Optional but recommended: protects /upload, /index, and /ask from anyone
# who can reach port 8000. Pick any string. If left blank, no auth is required.
API_KEY=pick-a-secret-string
